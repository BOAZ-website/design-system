{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "noEmitOnError": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "home/src",
    "outDir": "dist/home"
  },
  "include": ["home/src"],
  "exclude": ["home/src/**/*.test.ts", "home/src/**/*.test.tsx", "home/src/**/*.stories.tsx", "home/src/test"]
}
